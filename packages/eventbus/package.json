{
    "name": "@zentrade/eventbus",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "Durable eventing over Redis Streams: validated publish, consumer groups with retry/DLQ, replay. Interface deliberately mirrors JetStream semantics (subject, durable consumer, ack) so the transport is swappable.",
    "engines": {
        "node": ">=20"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@zentrade/contracts": "*",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "ioredis": "^5.4.2",
        "typescript": "^5.7.3",
        "vitest": "^2.1.9"
    }
}
