{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "venue": {
      "type": "string",
      "enum": [
        "NSE",
        "BSE"
      ]
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "resolution": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "60m",
        "1d",
        "1w",
        "1mo"
      ]
    },
    "candle": {
      "type": "object",
      "properties": {
        "time": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "open": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "high": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "low": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "close": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "time",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "venue",
    "symbol",
    "resolution",
    "candle"
  ],
  "additionalProperties": false
}
