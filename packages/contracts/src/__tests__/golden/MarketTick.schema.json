{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "change": {
      "type": "number"
    },
    "changePercent": {
      "type": "number"
    },
    "timestamp": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "open": {
      "type": "number",
      "minimum": 0
    },
    "previousClose": {
      "type": "number",
      "minimum": 0
    },
    "dayHigh": {
      "type": "number",
      "minimum": 0
    },
    "dayLow": {
      "type": "number",
      "minimum": 0
    },
    "volume": {
      "type": "number",
      "minimum": 0
    },
    "marketState": {
      "type": "string",
      "maxLength": 32
    }
  },
  "required": [
    "symbol",
    "name",
    "price",
    "change",
    "changePercent",
    "timestamp"
  ],
  "additionalProperties": false
}
