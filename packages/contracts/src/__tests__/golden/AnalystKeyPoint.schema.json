{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "point": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "refs": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*:[a-z0-9_.-]{1,32}$"
      }
    }
  },
  "required": [
    "point",
    "refs"
  ],
  "additionalProperties": false
}
