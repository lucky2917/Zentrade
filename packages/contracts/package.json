{
    "name": "@zentrade/contracts",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "The spine: versioned Zod schemas for every event, message and shared value object. Zero runtime deps besides zod.",
    "engines": {
        "node": ">=20"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "schemas": "npm run build && node scripts/export-json-schemas.mjs"
    },
    "dependencies": {
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "typescript": "^5.7.3",
        "vitest": "^2.1.9"
    }
}
