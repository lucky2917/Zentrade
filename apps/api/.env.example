PORT=5001
DATABASE_URL=postgresql://localhost:5432/zentrade
REDIS_URL=redis://localhost:6379
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# From the same OAuth client in Google Cloud Console — keep this secret, never commit a real value
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
FRONTEND_URL=http://localhost:5173
# In production, set this to your deployed frontend URL (e.g. https://zentrade.vercel.app)
# Zentrade AI — get free keys at:
# Groq (LLM): https://console.groq.com/keys
# Finnhub (stock news): https://finnhub.io/register
GROQ_API_KEY=your_groq_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Fyers API v3 — register an app at https://myapi.fyers.in/dashboard
# Daily login required (SEBI 2FA), token expires 3 AM IST every day
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_AUTH_CODE=
# Optional, defaults to ./logs if unset
FYERS_WS_LOG_PATH=

# Email watchdog — sends re-auth reminders and budget alerts via SMTP (e.g. iCloud Mail)
# Use an app-specific password, not your normal account password
WATCHDOG_EMAIL_USER=
WATCHDOG_EMAIL_PASS=
ALERT_EMAIL_TO=
# Optional SMTP overrides — defaults to iCloud Mail (smtp.mail.me.com:587)
SMTP_HOST=
SMTP_PORT=

# Verify the Postgres TLS cert against system roots — set true for providers
# with publicly-trusted certs (Neon, Supabase). For self-signed provider CAs
# use DB_CA_CERT with the PEM instead.
DB_SSL_VERIFY=

# Proxy hops in front of the server for client IP resolution (rate limiting).
# Defaults: 2 in production (Vercel edge + Render LB), 1 otherwise.
# After changing, check the "First request IP resolution sample" line in logs.
TRUST_PROXY_HOPS=

# Error monitoring — leave empty to disable Sentry entirely
SENTRY_DSN=

# Logging (M6): "json" emits OTel-shaped JSON lines (default: pretty console).
# LOG_SAMPLE_RATE 0..1 samples INFO-level chatter; TRADE lines never sampled.
LOG_FORMAT=
LOG_SAMPLE_RATE=
