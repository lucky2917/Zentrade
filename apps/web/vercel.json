{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://accounts.google.com https://zentrade-server.onrender.com wss://zentrade-server.onrender.com https://*.sentry.io; frame-src https://accounts.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://zentrade-server.onrender.com/api/:path*"
    },
    {
      "source": "/fyers/:path*",
      "destination": "https://zentrade-server.onrender.com/fyers/:path*"
    },
    {
      "source": "/socket.io/",
      "destination": "https://zentrade-server.onrender.com/socket.io/"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://zentrade-server.onrender.com/socket.io/:path*"
    },
    {
      "source": "/internal/cockpit/:path*",
      "destination": "https://zentrade-server.onrender.com/internal/cockpit/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
